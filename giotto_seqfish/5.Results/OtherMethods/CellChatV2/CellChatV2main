read_seqfish_expression <- function(path) {
  tab_df <- suppressWarnings(read.delim(path, sep = "\t", check.names = FALSE, stringsAsFactors = FALSE))

  if (ncol(tab_df) >= 2 && tolower(colnames(tab_df)[1]) == "gene") {
    genes <- tab_df[[1]]
    expr_mat <- as.matrix(tab_df[, -1, drop = FALSE])
    mode(expr_mat) <- "numeric"
    rownames(expr_mat) <- genes
    return(expr_mat)
  }

  lines <- readLines(path)
  if (length(lines) < 2) stop("empty or invalid expression file")

  barcodes <- strsplit(trimws(lines[1]), "\\s+")[[1]]
  data_lines <- lines[-1]
  split_lines <- strsplit(trimws(data_lines), "\\s+")

  genes <- vapply(split_lines, function(x) x[1], character(1))
  expr_values <- lapply(split_lines, function(x) as.numeric(x[-1]))
  expr_mat <- do.call(rbind, expr_values)

  colnames(expr_mat) <- barcodes
  rownames(expr_mat) <- genes
  expr_mat
}

